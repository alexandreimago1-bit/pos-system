@baseUrl = http://localhost:4001

### 1. GET all products (expect 200)
GET {{baseUrl}}/api/products

### 2. GET one product (paste a real _id from request 1, expect 200)
GET {{baseUrl}}/api/products/6aead79cd10eea37adff995f

### 3. GET malformed id (expect 400, "malformatted id")
GET {{baseUrl}}/api/products/abc

### 4. GET valid-format id that doesn't exist (expect 404, "product not found")
GET {{baseUrl}}/api/products/507f1f77bcf86cd799439011

### 5. POST valid product (expect 201)
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": "Lucky Me Pancit Canton",
  "barcode": "TEST--BARCODE--1",
  "priceInCentavos": 1500,
  "stock": 50
}

### 6. POST same barcode again (expect 409, "duplicate barcode")
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": "Lucky Me Pancit Canton",
  "barcode": "TEST--BARCODE--1",
  "priceInCentavos": 1500,
  "stock": 50
}

### 7. POST negative price (expect 400)
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": "Test Item",
  "barcode": "1111",
  "priceInCentavos": -100,
  "stock": 10
}

### 8. POST decimal price (expect 400, integer rule)
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": "Test Item",
  "barcode": "2222",
  "priceInCentavos": 15.5,
  "stock": 10
}

### 9. POST missing name (expect 400)
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "barcode": "3333",
  "priceInCentavos": 1000,
  "stock": 10
}

### 10. Unknown endpoint (expect 404, "unknown endpoint")
GET {{baseUrl}}/api/nothing